{
  "$schema": "https://opencode.ai/config.json",
  "username": "modpack-dev",
  "default_agent": "modder",
  "logLevel": "INFO",
  "instructions": ["AGENTS.md"],
  "provider": {
    "llamacpp": {
      "name": "LlamaCPP (tec.br)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.apps.tec.br/llamacpp/v1"
      },
      "models": {
        "Ornith-1.5-9B": {
          "name": "Ornith 1.5 9B (Vision)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "interleaved": "reasoning_content",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  },
  "agent": {
    "modder": {
      "description": "Minecraft Forge mod developer. Creates, modifies and debugs mods for 1.20.1.",
      "mode": "all",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "edit": "allow",
        "bash": {
          "git *": "allow",
          "gradle *": "allow",
          "dir *": "allow",
          "copy *": "allow",
          "del *": "ask",
          "*": "ask"
        }
      }
    }
  },
  "references": {
    "forge-docs": {
      "path": "https://docs.minecraftforge.net",
      "description": "Forge MDK documentation for 1.20.1"
    },
    "kubejs-docs": {
      "path": "kubejs/",
      "description": "KubeJS scripts for custom items, blocks and recipes"
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  }
}
