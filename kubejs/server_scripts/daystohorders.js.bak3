// ================================================================
//  DAYS TO HOARDERS - METEOR HORDE SYSTEM
//  A meteor falls from the sky -> opens a portal -> monsters emerge
//
//  CONFIG: kubejs/config/daystohorders.json
//  COMANDOS: /kubejs custom_command hordestatus
//            /kubejs custom_command hordeforce
//            /kubejs custom_command hordeskip
//            /kubejs custom_command hordenight
//
//  NOTAS: var (nunca const/let), overworld() (nao getLevel),
//         UtilsJS.getPath() (nao Path.resolve)
// ================================================================

// --- Java Class Loading ---
var $Zombie            = Java.loadClass('net.minecraft.world.entity.monster.Zombie');
var $Husk              = Java.loadClass('net.minecraft.world.entity.monster.Husk');
var $Drowned           = Java.loadClass('net.minecraft.world.entity.monster.Drowned');
var $Vindicator        = Java.loadClass('net.minecraft.world.entity.monster.Vindicator');
var $Blaze             = Java.loadClass('net.minecraft.world.entity.monster.Blaze');
var $WitherSkeleton    = Java.loadClass('net.minecraft.world.entity.monster.WitherSkeleton');
var $EntityType        = Java.loadClass('net.minecraft.world.entity.EntityType');
var $ItemStack         = Java.loadClass('net.minecraft.world.item.ItemStack');
var $Items             = Java.loadClass('net.minecraft.world.item.Items');
var $EquipmentSlot     = Java.loadClass('net.minecraft.world.entity.EquipmentSlot');
var $HeightmapTypes    = Java.loadClass('net.minecraft.world.level.levelgen.Heightmap$Types');
var $Component         = Java.loadClass('net.minecraft.network.chat.Component');
var $UtilsJS           = Java.loadClass('dev.latvian.mods.kubejs.util.UtilsJS');
var $JsonIO            = Java.loadClass('dev.latvian.mods.kubejs.util.JsonIO');
var $PrimedTnt         = Java.loadClass('net.minecraft.world.entity.item.PrimedTnt');
var $BlockPos          = Java.loadClass('net.minecraft.core.BlockPos');
var $Blocks            = Java.loadClass('net.minecraft.world.level.block.Blocks');
var $ParticleTypes     = Java.loadClass('net.minecraft.core.particles.ParticleTypes');
var $MobEffectInstance = Java.loadClass('net.minecraft.world.effect.MobEffectInstance');
var $MobEffects        = Java.loadClass('net.minecraft.world.effect.MobEffects');

var CONFIG_PATH = $UtilsJS.getPath('kubejs/config/daystohorders.json');

// ================================================================
//  CONFIG
// ================================================================
var hordeConfig = {
    intervalDays: 3,
    baseSize: 5,
    maxSize: 30,
    warningMinutes: 1,
    radius: 20,
    debug: true
};

function loadConfig() {
    try {
        var cfgJson = $JsonIO.readJson(CONFIG_PATH);
        if (cfgJson != null && cfgJson.isJsonObject()) {
            var obj = cfgJson.getAsJsonObject();
            if (obj.has('intervalDays'))   hordeConfig.intervalDays   = obj.get('intervalDays').getAsInt();
            if (obj.has('baseSize'))       hordeConfig.baseSize       = obj.get('baseSize').getAsInt();
            if (obj.has('maxSize'))        hordeConfig.maxSize        = obj.get('maxSize').getAsInt();
            if (obj.has('warningMinutes')) hordeConfig.warningMinutes = obj.get('warningMinutes').getAsInt();
            if (obj.has('radius'))         hordeConfig.radius         = obj.get('radius').getAsInt();
            if (obj.has('debug'))          hordeConfig.debug          = obj.get('debug').getAsBoolean();
        }
        hordeConfig.intervalDays = Math.max(1, hordeConfig.intervalDays);
        hordeConfig.baseSize = Math.max(1, Math.min(100, hordeConfig.baseSize));
        hordeConfig.maxSize = Math.max(hordeConfig.baseSize, Math.min(200, hordeConfig.maxSize));
        log('Config loaded: interval=' + hordeConfig.intervalDays + ' base=' + hordeConfig.baseSize
            + ' max=' + hordeConfig.maxSize + ' warn=' + hordeConfig.warningMinutes
            + ' radius=' + hordeConfig.radius + ' debug=' + hordeConfig.debug);
    } catch (e) {
        log('ERROR reading config: ' + e);
    }
}

// ================================================================
//  STATE
// ================================================================
var phase            = 'IDLE';   // IDLE | WARNING | METEOR | CHASE
var phaseTick        = 0;        // game tick when current phase started
var lastHordeDay     = -1;
var warningSent      = false;
var portalX          = 0;
var portalY          = 0;
var portalZ          = 0;
var targetDay        = 0;
var portalBuiltTick  = 0;
var spawnedMonsters  = [];

// ================================================================
//  LOGGING
// ================================================================
function log(msg)    { console.log('[DaysToHoarders] ' + msg); }
function logDebug(msg) { if (hordeConfig.debug) log('[DEBUG] ' + msg); }

// ================================================================
//  UTILITY
// ================================================================
function getDayNumber(rawLevel) {
    return Math.floor(rawLevel.getDayTime() / 24000);
}

function isNight(rawLevel) {
    var time = rawLevel.getDayTime() % 24000;
    return time >= 13000 && time < 23000;
}

function getTimeOfDay(rawLevel) {
    return rawLevel.getDayTime() % 24000;
}

function getGameTime(rawLevel) {
    // getGameTime() not available in KubeJS Nashorn for ServerLevel
    // Use dayTime as substitute (dayTime wraps every 24000 ticks)
    return rawLevel.getDayTime();
}

function getGroundY(rawLevel, x, z) {
    // Use heightmap first, fallback to sea level
    try {
        var y = rawLevel.getHeight($HeightmapTypes.MOTION_BLOCKING_NO_LEAVES, Math.floor(x), Math.floor(z));
        if (y > -60 && y < 320) return y;
    } catch (e) {}
    return rawLevel.getSeaLevel() + 1;
}

function getHordeSize(dayNumber) {
    return Math.min(hordeConfig.baseSize + Math.floor(dayNumber / 3), hordeConfig.maxSize);
}

function getHordeName(d) {
    if (d >= 30) return '\u00a74\u00a7lHorda Demoníaca';
    if (d >= 20) return '\u00a75\u00a7lHorda Obsidiana';
    if (d >= 15) return '\u00a7c\u00a7lHorda Ardente';
    if (d >= 10) return '\u00a71\u00a7lHorda Abissal';
    if (d >= 5)  return '\u00a7e\u00a7lHorda Errante';
    return '\u00a7a\u00a7lHorda Incipiente';
}

// ================================================================
//  MONSTER SELECTION
// ================================================================
function chooseMonsterType(dayNumber) {
    // Special mobs checked first, highest tier first
    if (dayNumber >= 30 && Math.random() < 0.10) return 'wither_skeleton';
    if (dayNumber >= 20 && Math.random() < 0.15) return 'blaze';
    if (dayNumber >= 15 && Math.random() < 0.20) return 'vindicator';
    // Base pool
    if (dayNumber >= 10 && Math.random() < 0.30) return 'drowned';
    if (dayNumber >= 5  && Math.random() < 0.40) return 'husk';
    return 'zombie';
}

function createMonster(rawLevel, x, y, z, dayNumber) {
    var type = chooseMonsterType(dayNumber);
    var monster;

    switch (type) {
        case 'wither_skeleton':
            monster = new $WitherSkeleton($EntityType.WITHER_SKELETON, rawLevel);
            break;
        case 'blaze':
            monster = new $Blaze($EntityType.BLAZE, rawLevel);
            break;
        case 'vindicator':
            monster = new $Vindicator($EntityType.VINDICATOR, rawLevel);
            break;
        case 'drowned':
            monster = new $Drowned($EntityType.DROWNED, rawLevel);
            break;
        case 'husk':
            monster = new $Husk($EntityType.HUSK, rawLevel);
            break;
        default:
            monster = new $Zombie($EntityType.ZOMBIE, rawLevel);
    }

    monster.setPos(x, y + 1, z);

    // Armor: scales with days (leather -> iron -> diamond)
    var armorChance = Math.min(0.8, 0.2 + dayNumber * 0.02);
    if (Math.random() < armorChance) {
        if (dayNumber >= 25) {
            equipArmor(monster, 'diamond');
        } else if (dayNumber >= 15) {
            equipArmor(monster, 'iron');
        } else if (dayNumber >= 5) {
            equipArmor(monster, 'leather');
        }
    }

    // Weapon: scales with days
    if (dayNumber >= 10 && Math.random() < 0.5) {
        if (dayNumber >= 25) {
            monster.setItemSlot($EquipmentSlot.MAINHAND, new $ItemStack($Items.DIAMOND_SWORD));
        } else if (dayNumber >= 15) {
            monster.setItemSlot($EquipmentSlot.MAINHAND, new $ItemStack($Items.IRON_SWORD));
        } else {
            monster.setItemSlot($EquipmentSlot.MAINHAND, new $ItemStack($Items.STONE_SWORD));
        }
    }

    // Custom name based on horde tier
    monster.setCustomName($Component.literal(getHordeName(dayNumber)));
    monster.setCustomNameVisible(true);

    // Persist until killed (no despawn)
    monster.setPersistenceRequired();

    logDebug('Spawned ' + type + ' at (' + Math.floor(x) + ',' + Math.floor(y + 1) + ',' + Math.floor(z) + ')');
    return monster;
}

function equipArmor(monster, tier) {
    if (tier === 'diamond') {
        monster.setItemSlot($EquipmentSlot.HEAD,   new $ItemStack($Items.DIAMOND_HELMET));
        monster.setItemSlot($EquipmentSlot.CHEST,  new $ItemStack($Items.DIAMOND_CHESTPLATE));
        monster.setItemSlot($EquipmentSlot.LEGS,   new $ItemStack($Items.DIAMOND_LEGGINGS));
        monster.setItemSlot($EquipmentSlot.FEET,   new $ItemStack($Items.DIAMOND_BOOTS));
    } else if (tier === 'iron') {
        monster.setItemSlot($EquipmentSlot.HEAD,   new $ItemStack($Items.IRON_HELMET));
        monster.setItemSlot($EquipmentSlot.CHEST,  new $ItemStack($Items.IRON_CHESTPLATE));
        monster.setItemSlot($EquipmentSlot.LEGS,   new $ItemStack($Items.IRON_LEGGINGS));
        monster.setItemSlot($EquipmentSlot.FEET,   new $ItemStack($Items.IRON_BOOTS));
    } else {
        monster.setItemSlot($EquipmentSlot.HEAD,   new $ItemStack($Items.LEATHER_HELMET));
        monster.setItemSlot($EquipmentSlot.CHEST,  new $ItemStack($Items.LEATHER_CHESTPLATE));
        monster.setItemSlot($EquipmentSlot.LEGS,   new $ItemStack($Items.LEATHER_LEGGINGS));
        monster.setItemSlot($EquipmentSlot.FEET,   new $ItemStack($Items.LEATHER_BOOTS));
    }
}

// ================================================================
//  PORTAL
// ================================================================
function buildPortal(rawLevel, cx, cy, cz) {
    var soulSand  = $Blocks.SOUL_SAND.defaultBlockState();
    var cryingObs = $Blocks.CRYING_OBSIDIAN.defaultBlockState();
    var soulFire  = $Blocks.SOUL_FIRE.defaultBlockState();

    // Bottom layer (y+0): 3 soul_sand
    rawLevel.setBlockAndUpdate(new $BlockPos(cx - 1, cy, cz), soulSand);
    rawLevel.setBlockAndUpdate(new $BlockPos(cx,     cy, cz), soulSand);
    rawLevel.setBlockAndUpdate(new $BlockPos(cx + 1, cy, cz), soulSand);

    // Middle layer (y+1): crying_obsidian | soul_fire | crying_obsidian
    rawLevel.setBlockAndUpdate(new $BlockPos(cx - 1, cy + 1, cz), cryingObs);
    rawLevel.setBlockAndUpdate(new $BlockPos(cx,     cy + 1, cz), soulFire);
    rawLevel.setBlockAndUpdate(new $BlockPos(cx + 1, cy + 1, cz), cryingObs);

    // Top layer (y+2): 3 crying_obsidian
    rawLevel.setBlockAndUpdate(new $BlockPos(cx - 1, cy + 2, cz), cryingObs);
    rawLevel.setBlockAndUpdate(new $BlockPos(cx,     cy + 2, cz), cryingObs);
    rawLevel.setBlockAndUpdate(new $BlockPos(cx + 1, cy + 2, cz), cryingObs);

    log('Portal built at (' + cx + ', ' + cy + ', ' + cz + ')');
}

function isPortalIntact(rawLevel) {
    for (var dx = -1; dx <= 1; dx++) {
        for (var dy = 0; dy <= 2; dy++) {
            var state = rawLevel.getBlockState(new $BlockPos(portalX + dx, portalY + dy, portalZ));
            if (!state.isAir()) {
                return true;
            }
        }
    }
    return false;
}

function removePortal(rawLevel) {
    if (portalX === 0 && portalZ === 0) return;
    try {
        var count = 0;
        for (var dx = -1; dx <= 1; dx++) {
            for (var dy = 0; dy <= 2; dy++) {
                var pos = new $BlockPos(portalX + dx, portalY + dy, portalZ);
                var before = rawLevel.getBlockState(pos);
                rawLevel.destroyBlock(pos, false);
                var after = rawLevel.getBlockState(pos);
                logDebug('Portal block (' + (portalX+dx) + ',' + (portalY+dy) + ',' + portalZ + '): ' + before + ' -> ' + after);
                count++;
            }
        }
        var firePos = new $BlockPos(portalX, portalY + 1, portalZ);
        rawLevel.destroyBlock(firePos, false);
        log('Portal removed: ' + count + ' blocks at (' + portalX + ', ' + portalY + ', ' + portalZ + ')');
    } catch (e) {
        log('Error removing portal: ' + e);
    }
}

// ================================================================
//  MONSTER TARGETING
// ================================================================
function targetNearestPlayer(monster, server) {
    var players = server.getPlayerList().getPlayers().toArray();
    var nearest = null;
    var nearDist = Infinity;
    for (var p = 0; p < players.length; p++) {
        var px = players[p].getX() - monster.getX();
        var py = players[p].getY() - monster.getY();
        var pz = players[p].getZ() - monster.getZ();
        var d = px * px + py * py + pz * pz;
        if (d < nearDist) {
            nearDist = d;
            nearest = players[p];
        }
    }
    if (nearest) {
        monster.setTarget(nearest);
    }
}

function clearMonsterTargets() {
    for (var m = 0; m < spawnedMonsters.length; m++) {
        try {
            if (spawnedMonsters[m] != null && spawnedMonsters[m].isAlive()) {
                spawnedMonsters[m].setTarget(null);
            }
        } catch (e) {
            // entity may have been removed
        }
    }
    spawnedMonsters = [];
}

function areAllMonstersDead() {
    for (var m = 0; m < spawnedMonsters.length; m++) {
        try {
            if (spawnedMonsters[m] != null && spawnedMonsters[m].isAlive()) {
                return false;
            }
        } catch (e) {
            // entity reference gone = dead
        }
    }
    return spawnedMonsters.length > 0;
}

// ================================================================
//  SPAWNING
// ================================================================
function doSpawning(rawLevel, server, dayNumber) {
    var hordeSize = getHordeSize(dayNumber);
    var spawned = 0;

    log('=== SPAWNING ' + hordeSize + ' monsters from portal ===');
    log('Portal at (' + portalX + ', ' + portalY + ', ' + portalZ + ')');

    spawnedMonsters = [];

    for (var i = 0; i < hordeSize; i++) {
        var sx = portalX + Math.floor((Math.random() - 0.5) * 10);  // ±5 blocks
        var sz = portalZ + Math.floor((Math.random() - 0.5) * 10);  // ±5 blocks

        if (isNaN(sx) || isNaN(sz)) {
            logDebug('Skipping NaN position: sx=' + sx + ' sz=' + sz);
            continue;
        }

        var sy = portalY + 1;

        logDebug('Spawning at (' + Math.floor(sx) + ',' + Math.floor(sy) + ',' + Math.floor(sz) + ')');

        var monster = createMonster(rawLevel, sx, sy, sz, dayNumber);
        rawLevel.addFreshEntity(monster);

        // Speed boost I for 10 seconds after spawning
        monster.addEffect(new $MobEffectInstance($MobEffects.MOVEMENT_SPEED, 200, 0));

        // Target nearest player
        targetNearestPlayer(monster, server);

        spawnedMonsters.push(monster);
        spawned++;
    }

    log('Spawned ' + spawned + ' monsters');
    return spawned;
}

// ================================================================
//  INIT
// ================================================================
loadConfig();

// ================================================================
//  SERVER EVENTS
// ================================================================
ServerEvents.loaded(function (event) {
    try {
        var rawLevel = event.server.overworld();
        if (!rawLevel) return;
        lastHordeDay    = getDayNumber(rawLevel);
        phase           = 'IDLE';
        warningSent     = false;
        spawnedMonsters = [];
        log('Server started. Day: ' + lastHordeDay);
    } catch (e) {
        log('ERROR in loaded: ' + e);
    }
});

ServerEvents.tick(function (event) {
    try {
        var rawLevel = event.server.overworld();
        if (!rawLevel) return;

        var dayNumber   = getDayNumber(rawLevel);
        var isNt        = isNight(rawLevel);
        var time        = getTimeOfDay(rawLevel);
        var gameTime    = getGameTime(rawLevel);
        var nextHordeDay = lastHordeDay + hordeConfig.intervalDays;

        // --------------------------------------------------------
        //  PHASE: IDLE
        // --------------------------------------------------------
        if (phase === 'IDLE') {
            if (isNt && dayNumber >= nextHordeDay && time >= 13000 && time < 13500) {
                phase = 'WARNING';
                phaseTick = gameTime;
                warningSent = true;

                var playerList = event.server.getPlayerList().getPlayers().toArray();
                var size = getHordeSize(dayNumber);
                for (var i = 0; i < playerList.length; i++) {
                    playerList[i].tell(
                        '\u00a7c\u00a7l\u26a0 AVISO: \u00a7eUm meteoro se aproxima!'
                        + ' \u00a7cDia ' + dayNumber
                        + ' | \u00a74' + getHordeName(dayNumber)
                        + '\u00a7c | \u00a77' + size + ' monstros'
                    );
                }
                log('Warning sent. METEOR in ' + hordeConfig.warningMinutes + ' minute(s).');
            }
        }

        // --------------------------------------------------------
        //  PHASE: WARNING
        // --------------------------------------------------------
        else if (phase === 'WARNING') {
            var warnTicks = hordeConfig.warningMinutes * 20 * 60;
            if (gameTime - phaseTick >= warnTicks) {
                // Safety: only transition if still in WARNING
                if (phase !== 'WARNING') return;
                phase = 'METEOR';
                phaseTick = gameTime;

                    // Pick a random player and offset position for meteor target
                    var playerList = event.server.getPlayerList().getPlayers().toArray();
                    if (playerList.length > 0) {
                    var target = playerList[Math.floor(Math.random() * playerList.length)];
                    portalX = Math.floor(target.getX() + (Math.random() - 0.5) * 60);
                    portalZ = Math.floor(target.getZ() + (Math.random() - 0.5) * 60);
                    portalY = target.blockPosition().getY();
                    log('Portal target Y set to ' + portalY + ' (player=' + target.getName() + ')');

                    // Spawn TNT primed entity at Y=200 — it will fall and explode naturally
                    var tnt = new $PrimedTnt(rawLevel, portalX + 0.5, 200, portalZ + 0.5, null);
                    tnt.setFuse(100);
                    rawLevel.addFreshEntity(tnt);

                    // Notify players
                    for (var i = 0; i < playerList.length; i++) {
                        playerList[i].tell(
                            '\u00a74\u00a7l☄ METEORO AVISTADO! \u00a7cImpacto iminente!'
                        );
                    }

                    log('Meteor TNT spawned at (' + portalX + ', 200, ' + portalZ
                        + ') target ground (' + portalX + ', ' + portalY + ', ' + portalZ + ')');
                } else {
                    phase = 'IDLE';
                    log('No players online, horde cancelled.');
                }
            }
        }

        // --------------------------------------------------------
        //  PHASE: METEOR (waiting for TNT to fall and explode)
        // --------------------------------------------------------
        else if (phase === 'METEOR') {
            // TNT fuse is 100 ticks; wait 105 to be safe
            if (gameTime - phaseTick >= 105) {
                // portalY stays at the player's Y from when meteor was launched

                // Build portal structure at impact point
                log('Building portal at (' + portalX + ', ' + portalY + ', ' + portalZ + ')');
                buildPortal(rawLevel, portalX, portalY, portalZ);

                // Guard: only transition if still in METEOR
                if (phase !== 'METEOR') return;
                phase = 'CHASE';
                phaseTick = gameTime;
                portalBuiltTick = gameTime;

                // Spawn monsters from the portal
                doSpawning(rawLevel, event.server, dayNumber);

                lastHordeDay = dayNumber;
                warningSent  = false;

                log('CHASE phase started. Portal active for 60 seconds.');
            }
        }

        // --------------------------------------------------------
        //  PHASE: CHASE
        // --------------------------------------------------------
        else if (phase === 'CHASE') {
            // Check if portal is broken
            var portalIntact = isPortalIntact(rawLevel);
            if (!portalIntact) {
                clearMonsterTargets();
                removePortal(rawLevel);
                log('Portal broken! Monsters lose target and wander.');
            }

            // Check if all monsters are dead or 60 seconds elapsed
            var allDead     = areAllMonstersDead();
            var timeExpired = (gameTime - portalBuiltTick >= 1200);

            if (allDead || timeExpired) {
                removePortal(rawLevel);
                // Guard: only transition if still in CHASE
                if (phase !== 'CHASE') return;
                phase = 'IDLE';
                spawnedMonsters = [];
                log('CHASE ended. AllDead=' + allDead + ' TimeExpired=' + timeExpired);
            } else if (portalIntact) {
                // Emit portal particles while active
                rawLevel.sendParticles(
                    $ParticleTypes.FLAME,
                    portalX + 0.5, portalY + 1, portalZ + 0.5,
                    3, 0.5, 0.5, 0.5, 0.01
                );
                rawLevel.sendParticles(
                    $ParticleTypes.SOUL_FIRE_FLAME,
                    portalX + 0.5, portalY + 1.5, portalZ + 0.5,
                    2, 0.3, 0.3, 0.3, 0.01
                );
            }
        }

    } catch (e) {
        log('ERROR in tick: ' + e);
    }
});

// ================================================================
//  CUSTOM COMMANDS
// ================================================================
ServerEvents.customCommand('hordestatus', function (event) {
    try {
        var rawLevel = event.server.overworld();
        var day = rawLevel ? getDayNumber(rawLevel) : 0;
        var next = lastHordeDay + hordeConfig.intervalDays;
        var aliveCount = 0;
        for (var m = 0; m < spawnedMonsters.length; m++) {
            try {
                if (spawnedMonsters[m] != null && spawnedMonsters[m].isAlive()) {
                    aliveCount++;
                }
            } catch (e) { /* ignore */ }
        }
        var msg = '[DaysToHoarders] Phase=' + phase
            + ' | Day=' + day
            + ' | LastHorde=Day' + lastHordeDay
            + ' | NextHorde=Day' + next
            + ' | Size=' + getHordeSize(day)
            + ' | Portal=(' + portalX + ',' + portalY + ',' + portalZ + ')'
            + ' | AliveMonsters=' + aliveCount;
        if (event.player) { event.player.tell(msg); } else { log(msg); }
    } catch (e) {
        log('ERROR in hordestatus: ' + e);
    }
});

ServerEvents.customCommand('hordeforce', function (event) {
    try {
        var rawLevel = event.server.overworld();
        if (!rawLevel) { log('Level not found.'); return; }
        var day = getDayNumber(rawLevel);
        var playerList = event.server.getPlayerList().getPlayers().toArray();
        if (playerList.length === 0) { log('No players online.'); return; }

        // Don't allow force if a horde is already active
        if (phase !== 'IDLE') {
            var msg = '[DaysToHoarders] Cannot force — phase is ' + phase + '. Wait for current horde to end.';
            if (event.player) { event.player.tell(msg); } else { log(msg); }
            return;
        }

        // Pick random player position
        var target = playerList[Math.floor(Math.random() * playerList.length)];
        portalX = Math.floor(target.getX() + (Math.random() - 0.5) * 60);
        portalZ = Math.floor(target.getZ() + (Math.random() - 0.5) * 60);
        portalY = target.blockPosition().getY();
        log('Portal target Y set to ' + portalY + ' (player=' + target.getName() + ')');

        // Spawn TNT
        var tnt = new $PrimedTnt(rawLevel, portalX + 0.5, 200, portalZ + 0.5, null);
        tnt.setFuse(100);
        rawLevel.addFreshEntity(tnt);

        // Notify
        for (var i = 0; i < playerList.length; i++) {
            playerList[i].tell(
                '\u00a74\u00a7l☄ METEORO FORÇADO! \u00a7cImpacto iminente!'
            );
        }

        phase         = 'METEOR';
        phaseTick     = getGameTime(rawLevel);
        lastHordeDay  = day;
        warningSent   = false;

        var msg = '[DaysToHoarders] METEOR FORCED on day ' + day + '!';
        if (event.player) { event.player.tell(msg); } else { log(msg); }
    } catch (e) {
        log('ERROR in hordeforce: ' + e);
    }
});

ServerEvents.customCommand('hordeskip', function (event) {
    try {
        var rawLevel = event.server.overworld();
        if (rawLevel) { lastHordeDay = getDayNumber(rawLevel); }
        phase        = 'IDLE';
        warningSent  = false;
        spawnedMonsters = [];
        var msg = '[DaysToHoarders] Next horde skipped.';
        if (event.player) { event.player.tell(msg); } else { log(msg); }
    } catch (e) {
        log('ERROR in hordeskip: ' + e);
    }
});

ServerEvents.customCommand('hordenight', function (event) {
    try {
        var rawLevel = event.server.overworld();
        if (!rawLevel) return;
        var currentDay = getDayNumber(rawLevel);
        var targetDay  = lastHordeDay + hordeConfig.intervalDays;
        var newTime    = targetDay * 24000 + 13500;
        rawLevel.setDayTime(newTime);
        lastHordeDay = targetDay - hordeConfig.intervalDays;
        warningSent  = false;
        phase        = 'IDLE';
        var msg = '[DaysToHoarders] Time set: day ' + targetDay + ' night (13500). Meteor incoming!';
        if (event.player) { event.player.tell(msg); } else { log(msg); }
    } catch (e) {
        log('ERROR in hordenight: ' + e);
    }
});
